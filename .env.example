# =============================================================
# NEXUS AI — Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================

# ─────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────
APP_ENV=development                # development | staging | production
APP_NAME=NEXUS AI
APP_VERSION=0.1.0
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR | CRITICAL
SECRET_KEY=change_this_to_a_long_random_secret_key_minimum_32_chars

# ─────────────────────────────────────────────
# BACKEND
# ─────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true                # Hot reload in development
BACKEND_WORKERS=1                  # Increase in production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─────────────────────────────────────────────
# FRONTEND
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=NEXUS AI

# ─────────────────────────────────────────────
# POSTGRESQL (Primary Database)
# ─────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus_ai
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_password
DATABASE_URL=postgresql+asyncpg://nexus:nexus_password@localhost:5432/nexus_ai

# ─────────────────────────────────────────────
# TIMESCALEDB (Time-Series — same PG instance, different extension)
# ─────────────────────────────────────────────
TIMESCALE_URL=postgresql+asyncpg://nexus:nexus_password@localhost:5432/nexus_ai

# ─────────────────────────────────────────────
# MONGODB (Documents: News, Events, Logs)
# ─────────────────────────────────────────────
MONGO_URL=mongodb://nexus:nexus_password@localhost:27017/nexus_ai?authSource=admin
MONGO_DB=nexus_ai

# ─────────────────────────────────────────────
# REDIS (Caching & Pub/Sub)
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300                # seconds

# ─────────────────────────────────────────────
# KAFKA (Streaming)
# ─────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_MARKET_DATA=nexus.market.data
KAFKA_TOPIC_OPTION_CHAIN=nexus.option.chain
KAFKA_TOPIC_SIGNALS=nexus.signals
KAFKA_TOPIC_ALERTS=nexus.alerts
KAFKA_TOPIC_NEWS=nexus.news

# ─────────────────────────────────────────────
# FREE DATA PROVIDERS (No API Key Needed)
# ─────────────────────────────────────────────
YFINANCE_CACHE_DIR=./data/cache/yfinance
NSE_BASE_URL=https://www.nseindia.com
NSE_REQUEST_DELAY=1.0              # seconds between NSE requests (rate limit)

# ─────────────────────────────────────────────
# NEWS API (Free Tier — 100 req/day)
# Sign up free at https://newsapi.org
# ─────────────────────────────────────────────
NEWS_API_KEY=your_free_newsapi_key_here

# ─────────────────────────────────────────────
# REDDIT API (Free — PRAW)
# Create app at https://www.reddit.com/prefs/apps
# ─────────────────────────────────────────────
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=nexus-ai/0.1.0

# ─────────────────────────────────────────────
# FRED API (Federal Reserve Economic Data — Free)
# Sign up at https://fred.stlouisfed.org/docs/api/api_key.html
# ─────────────────────────────────────────────
FRED_API_KEY=your_fred_api_key_here

# ─────────────────────────────────────────────
# ALERTS
# ─────────────────────────────────────────────
ALERT_SOUND_ENABLED=true
ALERT_DESKTOP_ENABLED=true
ALERT_MIN_CONFIDENCE=70            # Only alert above this confidence %
ALERT_QUIET_HOURS_START=21:00      # HH:MM
ALERT_QUIET_HOURS_END=09:00        # HH:MM

# ─────────────────────────────────────────────
# TRADING CONFIG
# ─────────────────────────────────────────────
PAPER_TRADING_MODE=true            # ALWAYS true until explicitly disabled
MIN_CONFIDENCE_THRESHOLD=65        # Below this → NO TRADE
HIGH_CONFIDENCE_THRESHOLD=80       # Above this → Strong signal
NIFTY_LOT_SIZE=75
MAX_DAILY_LOSS_PCT=2.0             # % of capital — hard stop
DEFAULT_CAPITAL=100000             # Paper trading capital (INR)

# ─────────────────────────────────────────────
# ML / MODEL CONFIG
# ─────────────────────────────────────────────
MODEL_REGISTRY_PATH=./ml/registry
FEATURE_STORE_PATH=./data/feature_store
LOOKBACK_BARS=100                  # Bars of history for model input
PREDICTION_HORIZON=5               # Bars ahead to predict
RETRAIN_INTERVAL_HOURS=24          # How often to retrain models
